config {
  type: "operations",
  hasOutput: true,
  schema: "analytics",
  name: "game_neighbors",
  description: "Precomputed similar-games lists, one row per (profile, game). Each profile is a parameter set from the bgg-viewer tuning bench: a similarity/rating blend, an optional source-relative complexity band, hard similarity / rating-percentile floors, and an optional per-product-line cap. The read API reads one game at a time — either one profile (the /similar endpoint) or all three (the game document) — so the table is CLUSTERed game_id first; tuning parameters ride on the row so the table is self-describing. Built one profile per BigQuery job (CREATE then INSERT) so each cross-join stays under the on-demand CPU ceiling."
}

js {
  // Profiles live in includes/similarity_profiles.js — the one source of truth. Edit
  // that (or re-copy from the bench), not this file. `source_min_users_rated` is the
  // knob that keeps each job affordable: `similar` covers every game (game-page
  // default); the explore profiles only compute for games with a few ratings.
  const PROFILES = similarity_profiles.profiles;

  // The literal SQL body below spells out exactly three statements (one per
  // profile). If the profile list changes length, that body is wrong — fail the
  // compile rather than silently build a subset.
  if (PROFILES.length !== 3) {
    throw new Error(
      `game_neighbors expects exactly 3 profiles, got ${PROFILES.length}. ` +
      `Add/remove a statement in the SQL body to match.`
    );
  }

  function embeddingColumn(dims) {
    return dims === 64 ? "embedding" : `embedding_${dims}`;
  }
  function orNull(v, type) {
    return v === null || v === undefined ? `CAST(NULL AS ${type})` : v;
  }
  const hasCap = (p) => p.max_per_family !== null && p.max_per_family !== undefined;
  const hasBand = (p) => p.complexity_band !== null && p.complexity_band !== undefined;

  // One profile's full `WITH … SELECT … GROUP BY` — self-contained so it can be its own
  // statement (its own CPU budget). The dot product (ML.DISTANCE) is evaluated once.
  function profileQuery(p) {
    return `
WITH rating_pct AS (
  -- global geek-rating percentile: the rating half of the blend. Unrated games
  -- (geek_rating = 0) are absent and score 0 via COALESCE below.
  SELECT game_id, PERCENT_RANK() OVER (ORDER BY geek_rating) AS geek_pct
  FROM ${ref("game_similarity_search")}
  WHERE geek_rating > 0
),
candidates AS (
  SELECT game_id, name, year_published, complexity, ${embeddingColumn(p.dims)} AS embedding
  FROM ${ref("game_similarity_search")}
  WHERE users_rated >= ${p.min_users_rated} AND complexity IS NOT NULL
),
sources AS (
  SELECT game_id, complexity, ${embeddingColumn(p.dims)} AS embedding
  FROM ${ref("game_similarity_search")}
  WHERE users_rated >= ${p.source_min_users_rated} AND complexity IS NOT NULL
),
pairs AS (
  SELECT
    s.game_id AS src_game_id,
    t.game_id AS nbr_game_id,
    t.name AS nbr_name,
    t.year_published AS nbr_year_published,
    ML.DISTANCE(s.embedding, t.embedding, '${p.distance}') AS distance,
    COALESCE(rp.geek_pct, 0) AS nbr_geek_pct,
    pl.product_line_id AS nbr_product_line
  FROM sources s
  JOIN candidates t
    ON t.game_id != s.game_id${hasBand(p) ? `
   AND t.complexity BETWEEN s.complexity - ${p.complexity_band} AND s.complexity + ${p.complexity_band}` : ``}
  LEFT JOIN rating_pct rp ON rp.game_id = t.game_id
  LEFT JOIN ${ref("game_product_line")} pl ON pl.game_id = t.game_id
),
scored AS (
  SELECT
    *,
    ${p.weight} * (1 - distance) + (1 - ${p.weight}) * nbr_geek_pct AS score
  FROM pairs
  WHERE (1 - distance) >= ${p.min_similarity}
    AND (${p.min_rating_pct} = 0 OR nbr_geek_pct >= ${p.min_rating_pct})
),${hasCap(p) ? `
line_ranked AS (
  -- cap N per product line: a candidate with no line is never capped
  SELECT
    *,
    IF(
      nbr_product_line IS NULL, 1,
      ROW_NUMBER() OVER (PARTITION BY src_game_id, nbr_product_line ORDER BY score DESC)
    ) AS line_rn
  FROM scored
),
kept AS (SELECT * FROM line_ranked WHERE line_rn <= ${p.max_per_family}),` : ``}
ranked AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY src_game_id ORDER BY score DESC) AS rn
  FROM ${hasCap(p) ? "kept" : "scored"}
)
SELECT
  '${p.name}' AS profile,
  src_game_id AS game_id,
  ARRAY_AGG(
    STRUCT(nbr_game_id AS game_id, nbr_name AS name, nbr_year_published AS year_published, distance)
    ORDER BY score DESC
  ) AS similar,
  CAST(${p.weight} AS FLOAT64) AS weight,
  ${p.min_users_rated} AS min_users_rated,
  ${p.source_min_users_rated} AS source_min_users_rated,
  ${orNull(hasBand(p) ? p.complexity_band : null, "FLOAT64")} AS complexity_band,
  ${orNull(hasCap(p) ? p.max_per_family : null, "INT64")} AS max_per_family,
  CAST(${p.min_similarity} AS FLOAT64) AS min_similarity,
  CAST(${p.min_rating_pct} AS FLOAT64) AS min_rating_pct,
  '${p.distance}' AS distance_type,
  ${p.dims} AS embedding_dims,
  CURRENT_TIMESTAMP() AS computed_ts
FROM ranked
WHERE rn <= ${p.top_k}
GROUP BY src_game_id`;
  }
}

-- One BigQuery job per statement (each `---` starts a new job, each with its own
-- CPU budget). The `---` split is only honoured in this literal SQL body, not in
-- JS-generated strings — so the three profiles are spelled out here rather than
-- looped. The js{} block asserts PROFILES.length === 3 so adding one fails the
-- compile check instead of silently dropping.

-- CREATE OR REPLACE cannot change an existing table's CLUSTER BY spec, so drop first.
-- Harmless to keep: this operations model rebuilds the whole table every run anyway.
DROP TABLE IF EXISTS ${self()}

---

CREATE OR REPLACE TABLE ${self()}
-- game_id leads: every read filters one game_id (one profile for /similar, all three
-- for the game document). profile-first pruning was useless for the all-profiles read
-- and doubled its scan; game_id-first serves both from ~one block.
CLUSTER BY game_id, profile
AS
${profileQuery(PROFILES[0])}

---

INSERT INTO ${self()}
${profileQuery(PROFILES[1])}

---

INSERT INTO ${self()}
${profileQuery(PROFILES[2])}
