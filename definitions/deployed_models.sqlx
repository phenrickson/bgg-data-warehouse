config {
  type: "table",
  tags: ["publish"],
  schema: "monitoring",
  name: "deployed_models",
  description: "The model each scoring step used in its latest run within 30 days: one row per step, and per user and outcome for collections. Read from the landing tables each service writes, so it shows what ran, not what is configured. A step with no rows in 30 days has no row."
}

-- Each source is pruned to 30 days on its partition column, then cut to its latest run:
-- every row within 3 hours of its newest. A run spans many job_ids (the services mint one
-- per batch request), so job_id is just one of the run's jobs, for tracing.
WITH preds AS (
  SELECT * FROM ${ref("bgg-predictive-models", "raw", "ml_predictions_landing")}
  WHERE score_ts >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY)
),
preds_latest AS (
  SELECT * FROM preds
  WHERE score_ts >= (SELECT MAX(score_ts) FROM preds) - INTERVAL 3 HOUR
),
complexity AS (
  SELECT * FROM ${ref("bgg-predictive-models", "raw", "complexity_predictions")}
  WHERE score_ts >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY)
),
complexity_latest AS (
  SELECT * FROM complexity
  WHERE score_ts >= (SELECT MAX(score_ts) FROM complexity) - INTERVAL 3 HOUR
),
text_emb AS (
  SELECT job_id, embedding_model, embedding_version, created_ts
  FROM ${ref("bgg-predictive-models", "raw", "description_embeddings")}
  WHERE created_ts >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY)
),
text_emb_latest AS (
  SELECT * FROM text_emb
  WHERE created_ts >= (SELECT MAX(created_ts) FROM text_emb) - INTERVAL 3 HOUR
),
game_emb AS (
  SELECT job_id, embedding_model, embedding_version, created_ts
  FROM ${ref("bgg-predictive-models", "raw", "game_embeddings")}
  WHERE created_ts >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY)
),
game_emb_latest AS (
  SELECT * FROM game_emb
  WHERE created_ts >= (SELECT MAX(created_ts) FROM game_emb) - INTERVAL 3 HOUR
),
coll AS (
  SELECT job_id, username, outcome, model_name, model_version, score_ts
  FROM ${ref("bgg-predictive-models", "raw", "collection_predictions_landing")}
  WHERE score_ts >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY)
),
coll_latest AS (
  SELECT * FROM coll
  WHERE TRUE
  QUALIFY score_ts >= MAX(score_ts) OVER (PARTITION BY username, outcome) - INTERVAL 3 HOUR
),

-- Each step's latest run: its model and when it last wrote.
latest AS (
  SELECT 'game' AS model_category, 'hurdle' AS model_type, CAST(NULL AS STRING) AS username,
         hurdle_model_name AS model_name, CAST(hurdle_model_version AS STRING) AS model_version,
         MAX(score_ts) AS last_scored, ANY_VALUE(job_id) AS job_id
  FROM preds_latest GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'rating', NULL, rating_model_name, CAST(rating_model_version AS STRING),
         MAX(score_ts), ANY_VALUE(job_id)
  FROM preds_latest GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'users_rated', NULL, users_rated_model_name,
         CAST(users_rated_model_version AS STRING), MAX(score_ts), ANY_VALUE(job_id)
  FROM preds_latest GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'geek_rating', NULL, geek_rating_model_name,
         CAST(geek_rating_model_version AS STRING), MAX(score_ts), ANY_VALUE(job_id)
  FROM preds_latest GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'complexity', NULL, complexity_model_name,
         CAST(complexity_model_version AS STRING), MAX(score_ts), ANY_VALUE(job_id)
  FROM complexity_latest GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'text_embedding', NULL, embedding_model, CAST(embedding_version AS STRING),
         MAX(created_ts), ANY_VALUE(job_id)
  FROM text_emb_latest GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'game_embedding', NULL, embedding_model, CAST(embedding_version AS STRING),
         MAX(created_ts), ANY_VALUE(job_id)
  FROM game_emb_latest GROUP BY 4, 5
  UNION ALL
  SELECT 'collection', outcome, username, model_name, CAST(model_version AS STRING),
         MAX(score_ts), ANY_VALUE(job_id)
  FROM coll_latest GROUP BY outcome, username, model_name, model_version
),

-- Every game in each serving table, by the model and version behind its current row.
served AS (
  SELECT 'game' AS cat, 'hurdle' AS t, CAST(NULL AS STRING) AS username, hurdle_model_name AS n,
         CAST(hurdle_model_version AS STRING) AS v, COUNT(*) AS c
  FROM ${ref("bgg_predictions")} GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'rating', NULL, rating_model_name, CAST(rating_model_version AS STRING), COUNT(*)
  FROM ${ref("bgg_predictions")} GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'users_rated', NULL, users_rated_model_name,
         CAST(users_rated_model_version AS STRING), COUNT(*)
  FROM ${ref("bgg_predictions")} GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'geek_rating', NULL, geek_rating_model_name,
         CAST(geek_rating_model_version AS STRING), COUNT(*)
  FROM ${ref("bgg_predictions")} GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'complexity', NULL, complexity_model_name,
         CAST(complexity_model_version AS STRING), COUNT(*)
  FROM ${ref("bgg_complexity_predictions")} GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'text_embedding', NULL, embedding_model, CAST(embedding_version AS STRING), COUNT(*)
  FROM ${ref("bgg_description_embeddings")} GROUP BY 4, 5
  UNION ALL
  SELECT 'game', 'game_embedding', NULL, embedding_model, CAST(embedding_version AS STRING), COUNT(*)
  FROM ${ref("bgg_game_embeddings")} GROUP BY 4, 5
  UNION ALL
  SELECT 'collection', outcome, username, model_name, CAST(model_version AS STRING), COUNT(*)
  FROM ${ref("user_collection_predictions")} GROUP BY 2, 3, 4, 5
)

-- games_served: games whose current row came from this step's latest model.
-- games_total: every game in that serving table (per user and outcome for collections).
SELECT l.model_category, l.model_type, l.username, l.model_name, l.model_version, l.last_scored,
       COALESCE(SUM(IF(s.n = l.model_name AND s.v = l.model_version, s.c, 0)), 0) AS games_served,
       COALESCE(SUM(s.c), 0) AS games_total,
       l.job_id
FROM latest l
LEFT JOIN served s
  ON s.cat = l.model_category AND s.t = l.model_type
 AND s.username IS NOT DISTINCT FROM l.username
GROUP BY l.model_category, l.model_type, l.username, l.model_name, l.model_version,
         l.last_scored, l.job_id
